  "html_body": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" style=\"margin:0;padding:0\">\r\r\n\r\r\n<head style=\"margin:0;padding:0\">\r\r\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" style=\"margin:0;padding:0\">\r\r\n  <meta name=\"viewport\" content=\"width=device-width\" style=\"margin:0;padding:0\">\r\r\n  <title style=\"margin:0;padding:0\">スペースマーケット</title>\r\r\n  \r\r\n<style>a:link{color:#111111;text-decoration:underline}\r\r\na:visited{color:#111111;text-decoration:underline}\r\r\na:active{color:#111111;text-decoration:none}\r\r\na:hover{color:#111111;text-decoration:none}</style></head>\r\r\n\r\r\n<body bgcolor=\"#FFFFFF\" text=\"#000000\" link=\"#111111\" vlink=\"#111111\" alink=\"#111111\" leftmargin=\"0\" topmargin=\"0\" marginwidth=\"0\" marginheight=\"0\" style='margin:0;padding:0;color:#111111;font-family:\"Hiragino Kaku Gothic ProN\", \"ヒラギノ角ゴ ProN W3\", \"ヒラギノ角ゴ StdN\", \"Hiragino Kaku Gothic StdN\", \"メイリオ\", Meiryo, \"ヒラギノ角ゴシック\", \"Hiragino Sans\", \"Verdana\", \"Osaka\", \"ＭＳ Ｐゴシック\", \"MS PGothic\", sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%'>\r\r\n  <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:0;padding:0;font-size:14px;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;width:100%;max-width:640px; margin: auto; line-height: 1.6\">\r\r\n    <tr style=\"margin:0;padding:0\">\r\r\n  <td style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;text-align:center;padding-top:24px;\"><img width=\"194\" height=\"29\" src=\"http://cdnspacemarket.com/images/email/logo.png\" style=\"margin:0;padding:0;border:0;height:auto;line-height:100%;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic\"></td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n    <td style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;text-align:center;padding-top:24px;font-size:21px;font-weight:bold;line-height:1.35;\">予約が完了しました</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <td style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;padding:10px 10px 50px 10px;\">\r\r\n      利用料金のお支払いを確認し、予約が完了しました。\r\r\n  </td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <td style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;text-align:center;padding:20px 10px;\">\r\r\n    <a style=\"margin:0;padding:0;padding:13px 60px;background:#00A273;color:#FFF;text-decoration:none;font-size:13px;border-radius:3px;\" href=\"https://dashboard.spacemarket.com/of4x48usi2_b8kyu/inbox/6115239\">予約詳細へ</a>\r\r\n  </td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <td style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;padding:10px 10px 50px 10px;\">\r\r\n    <h4 style=\"margin:0;padding:0;font-size:100%;color:#bab9b3; font-size: 14px; margin:0 0 5px 0; padding:20px 10px 10px 10px\">今後の流れ</h4>\r\r\n    予約日時にご対応ください。\r\r\n    不明点等は、引き続きゲストとメッセージ機能でやりとりいただけます。\r\r\n  </td>\r\r\n</tr>\r\r\n<!-- note -->\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <td style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;padding:0 10px 10px;\">\r\r\n    <p style=\"margin:0;padding:0;text-align:center;padding:0;margin:0 0 10px;font-size:18px;font-weight:bold;\">予約リクエストの変更について</p>\r\r\n      <p style=\"margin:0;padding:0;margin:0 0 20px;text-align:left;font-size:14px;\">\r\r\n        予約リクエストの変更は、 <strong style=\"margin:0;padding:0\">スペース利用終了日の翌月2日</strong> までとなっております。金額等が変更になった場合、期限までに予約変更リクエストをして、ゲストから承諾を得てください。詳細は<a href=\"https://support.spacemarket.com/ja/articles/39c7de9d\" style=\"margin:0;padding:0;text-decoration:none;color:#00a273;\">予約の変更方法</a>をご確認ください。\r\r\n      </p>\r\r\n  </td>\r\r\n</tr>\r\r\n<!-- /note -->\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <td style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;padding:0px 10px 40px;\">\r\r\n    <p style=\"margin:0;padding:0;text-align:center;padding:0;margin:0 0 16px;font-size:18px;font-weight:bold;\">予約リクエスト内容</p>\r\r\n    <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin:0;padding:0;font-size:14px;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt\">\r\r\n      <tbody style=\"margin:0;padding:0\">\r\r\n        <tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding: 12px 0 3px;\">予約ID</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left;padding-top:0px;padding-bottom:16px;\">6115239</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding:12px 0 3px;\">お名前</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left; padding-top:0px;padding-bottom:16px;\">伊藤 次郎</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding:12px 0 3px;\">法人・団体名</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left; padding-top:0px;padding-bottom:16px;\">-</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding:12px 0 3px;\">スペース名</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left; padding-top:0px;padding-bottom:16px;\">★9月限定キャンペーン中★ ラグジュアリーな隠れ家バー　※代官山徒歩1分</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;vertical-align:top;padding-top:10px;font-weight:normal;color:#999;\">住所</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left; vertical-align:top;padding-top:0px;padding-bottom:10px;\">東京都渋谷区代官山町20-9サザン代官山２Ｆ－Ｃ</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding: 12px 0 3px;\">利用期間</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left;padding-top:0px;padding-bottom:16px;\">\r\r\n      2026/9/10(木) 14:00〜16:00\r\r\n  </td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding:12px 0 3px;\">人数</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left;padding-top:0px;padding-bottom:16px;\">\r\r\n  〜3人</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;vertical-align:top;padding-top:10px;font-weight:normal;color:#999;\">利用目的</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left; vertical-align:top;padding-top:0px;padding-bottom:10px;\">インタビュー・取材</td>\r\r\n</tr>\r\r\n<tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding:12px 0 3px;\">利用用途の詳細</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left;padding-top:0px;padding-bottom:16px;\"><p style=\"margin:0;padding:0\"></p></td>\r\r\n</tr>\r\r\n\r\r\n        <tr style=\"margin:0;padding:0\">\r\r\n  <th align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-top:1px solid #eaeaea;display:block;width:100%;text-align:left;padding:12px 0 3px;\">利用料金</th>\r\r\n  <td align=\"left\" width=\"100%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;display:block;width:100%;text-align:left;padding-top:0px;padding-bottom:16px;\">\r\r\n    <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;padding:0;font-size:14px;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;width:100%;\">\r\r\n      <tbody style=\"margin:0;padding:0\">\r\r\n        <tr style=\"margin:0;padding:0\">\r\r\n          <th align=\"left\" width=\"36%\" style=\"margin:0;padding:0;width:36%;text-align:left;vertical-align:top;padding:4px 0;font-weight:normal;\">プラン料金</th>\r\r\n          <td align=\"left\" width=\"64%\" style=\"margin:0;padding:0;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;width:64%;text-align:left;vertical -align:top;padding:4px 0;font-weight:normal;\">昼プラン（￥6,